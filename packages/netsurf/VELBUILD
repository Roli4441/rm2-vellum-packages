pkgrel=1
upstream_author="alex0809"
category="apps"
pkgdesc="A lightweight web browser for reMarkable tablets."
url="https://github.com/alex0809/netsurf-reMarkable"
arch="armv7"
license="GPL-2.0-or-later"
depends="appload"
options="!check !fhs !strip !tracedeps"

source="
https://github.com/alex0809/netsurf-reMarkable/releases/download/v0.4/nsfb.tar.gz
https://github.com/alex0809/netsurf-reMarkable/releases/download/v0.4/LICENSE
external.manifest.json
Choices
"

unpack() {
	tar -xzf "$srcdir"/nsfb.tar.gz -C "$srcdir"
}

package() {
	local appdir="$pkgdir"/home/root/xovi/exthome/appload/netsurf

	# AppLoad app directory
	install -d "$appdir"

	# AppLoad external manifest
	install -Dm644 "$srcdir"/external.manifest.json \
		"$appdir"/external.manifest.json

	# NetSurf binary
	install -Dm755 "$srcdir"/nsfb "$appdir"/nsfb

	# App icon (from netsurf resources)
	install -Dm644 "$srcdir"/resources/netsurf.png "$appdir"/icon.png

	# Browser resources (CSS, icons, HTML, CA bundle, etc.)
	install -d "$appdir"/resources
	cp -r "$srcdir"/resources/* "$appdir"/resources/

	# Default configuration (font paths, scale, toolbar, etc.)
	install -d "$pkgdir"/home/root/.netsurf
	install -Dm644 "$srcdir"/Choices \
		"$pkgdir"/home/root/.netsurf/Choices

	# License
	install -Dm644 "$srcdir"/LICENSE \
		"$pkgdir"/home/root/.vellum/licenses/$pkgname/LICENSE
	echo "https://github.com/alex0809/netsurf-reMarkable/archive/refs/tags/v0.4.tar.gz" > \
		"$pkgdir"/home/root/.vellum/licenses/$pkgname/SOURCES
}

postinstall() {
	# Ensure libevdev.so.2 is available for the nsfb binary
	local appdir="/home/root/xovi/exthome/appload/netsurf"
	if [ ! -f "$appdir/libevdev.so.2" ]; then
		# Try to copy from system library paths
		for libpath in /usr/lib/libevdev.so.2 /lib/libevdev.so.2 /usr/lib/arm-linux-gnueabihf/libevdev.so.2; do
			if [ -f "$libpath" ]; then
				cp "$libpath" "$appdir/libevdev.so.2"
				echo "Copied libevdev.so.2 from $libpath"
				break
			fi
		done
		if [ ! -f "$appdir/libevdev.so.2" ]; then
			echo "WARNING: libevdev.so.2 not found on this system."
			echo "NetSurf may not start. Please manually place libevdev.so.2 in:"
			echo "  $appdir/"
		fi
	fi
	echo ""
	echo "NetSurf installed! Please refresh AppLoad to see it in the launcher."
}

postdeinstall() {
	if [ "$VELLUM_PURGE" = "1" ]; then
		rm -rf \
			/home/root/.netsurf \
			/home/root/xovi/exthome/appload/netsurf
	fi
}

