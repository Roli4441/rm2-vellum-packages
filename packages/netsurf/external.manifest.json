{
    "name": "NetSurf",
    "application": "nsfb",
    "args": ["-v"],
    "workingDirectory": "/home/root/xovi/exthome/appload/netsurf",
    "environment": {
        "HOME": "/home/root",
        "NETSURFRES": "/home/root/xovi/exthome/appload/netsurf/resources/",
