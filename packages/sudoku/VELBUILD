# Converted from Toltec ipk: https://github.com/HookedBehemoth/remarkable-sudoku
# Native Sudoku game with pen input for reMarkable

maintainer="Roli4441 <roli4441@users.noreply.github.com>"
pkgname=sudoku
pkgver=0.1.2
pkgrel=1
upstream_author="HookedBehemoth"
category="games"
pkgdesc="Sudoku puzzle game with pen input for reMarkable tablets."
url="https://github.com/HookedBehemoth/remarkable-sudoku"
arch="armv7"
license="GPL-3.0-only"
depends="appload"
options="!check !fhs !strip !tracedeps"

source="
https://github.com/HookedBehemoth/remarkable-sudoku/releases/download/v0.1.2/sudoku_0.1.2-1_rmall.ipk
external.manifest.json
"

unpack() {
	# Extract binary and icon from ipk (ipk is a tar.gz containing data.tar.gz)
	cd "$srcdir"
	tar -xzf sudoku_0.1.2-1_rmall.ipk
	tar -xzf data.tar.gz
}

package() {
	local appdir="$pkgdir"/home/root/xovi/exthome/appload/sudoku

	# AppLoad app directory
	install -d "$appdir"

	# AppLoad external manifest
	install -Dm644 "$srcdir"/external.manifest.json \
		"$appdir"/external.manifest.json

	# Sudoku binary (extracted from ipk)
	install -Dm755 "$srcdir"/opt/bin/sudoku "$appdir"/sudoku

	# App icon (702x702 from ipk)
	install -Dm644 "$srcdir"/opt/etc/draft/icons/sudoku.png "$appdir"/icon.png

	# License (from ipk control)
	install -d "$pkgdir"/home/root/.vellum/licenses/$pkgname
	echo "GPL-3.0-only" > "$pkgdir"/home/root/.vellum/licenses/$pkgname/LICENSE
	echo "https://github.com/HookedBehemoth/remarkable-sudoku" > \
		"$pkgdir"/home/root/.vellum/licenses/$pkgname/SOURCES
}

postinstall() {
	echo ""
	echo "Sudoku installed! Please refresh AppLoad to see it in the launcher."
}

postdeinstall() {
	if [ "$VELLUM_PURGE" = "1" ]; then
		rm -rf /home/root/xovi/exthome/appload/sudoku
	fi
}

